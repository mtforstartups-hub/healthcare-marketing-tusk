# ---------------------------------------------------------------------------
# MySQL (hosted outside Vercel)
# ---------------------------------------------------------------------------
# Example: mysql://app_user:password@mysql.example.com:3306/marketing_tusk
DATABASE_URL=<mysql-connection-string>

# Keep this small so many Vercel instances do not exhaust MySQL connections.
DATABASE_POOL_SIZE=5

# Enable when your MySQL host requires TLS. Set the second value to false only
# if the host uses a certificate this runtime cannot verify.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# Enquiry storage and owner sign-in
# ---------------------------------------------------------------------------
# Exactly 64 hexadecimal characters. Preserve this value across deployments so
# existing encrypted enquiry records stay readable.
INTAKE_ENCRYPTION_KEY=<64-hex-character-secret>

# A long, unique owner password for /studio/login.
ADMIN_PASSWORD=<strong-owner-password>

# Signs the owner session cookie. Use at least 32 random characters. If unset,
# INTAKE_ENCRYPTION_KEY is used as a fallback.
AUTH_SECRET=<at-least-32-random-characters>

# ---------------------------------------------------------------------------
# Launch and search indexing
# ---------------------------------------------------------------------------
SITE_ACCESS_MODE=owner-private
# Set SEO_INDEXING=public only after the final hostname and launch review.
# SEO_INDEXING=public
# SEO_PUBLIC_ORIGIN=https://healthcare.marketingtusk.com
# Origin used for canonical URLs while indexing is disabled.
SITE_REVIEW_ORIGIN=https://healthcare.marketingtusk.com

# ---------------------------------------------------------------------------
# Optional CRM outbox (records are queued but not delivered in this release)
# ---------------------------------------------------------------------------
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=
